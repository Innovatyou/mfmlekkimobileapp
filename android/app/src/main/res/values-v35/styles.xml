<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting -->
    <!-- For Android 15+ (API 35+), using modern edge-to-edge display configuration -->
    <style name="LaunchTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             Flutter draws its first frame -->
        <item name="android:windowSplashScreenBackground">@drawable/launch_background</item>
        <!-- Edge-to-edge display - do not draw system bars -->
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <!-- Disable forced dark mode -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.
         
         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Modern edge-to-edge configuration for Android 15+ -->
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
